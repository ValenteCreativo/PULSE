# Data source: keep this public URL unless using an authorized mirror.
PULSE_DATASET_REPO=kuben-developer/tiktok-videos-4b
PULSE_DATASET_MAX_BYTES=52428800
PULSE_DATASET_MAX_ROWS=10000
PULSE_DATASET_TIMEOUT_MS=20000

# Configure only when later payment/agent milestones require them.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_MODEL=
MONAD_RPC_URL=
MONAD_CHAIN_ID=10143
PULSE_PAYMENT_RECIPIENT=
PULSE_CONTRACT_ADDRESS=
PULSE_MIN_CONFIRMATIONS=2
# Read-only first-purchase preflight inputs. Keep blank until the operator selects real identifiers.
PULSE_PURCHASE_BUYER=
PULSE_FIRST_PRODUCT_ID=
PULSE_FIRST_TOPIC_ID=
PULSE_FIRST_PURCHASE_ID=
# Required only by the guarded deploy:monad-testnet command. Never use a wallet with mainnet funds.
PULSE_DEPLOYER_PRIVATE_KEY=
# Set to MONAD_TESTNET only immediately before an explicitly approved deployment.
PULSE_DEPLOY_CONFIRM=
ENVIO_API_TOKEN=
# Hosted Envio GraphQL endpoint. Configure this server-side in Vercel; it is public but not needed in browser bundles.
PULSE_ENVIO_GRAPHQL_URL=
