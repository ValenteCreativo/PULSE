{
  "name": "pulse-attention-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "check": "tsc --noEmit",
    "build:core": "tsc -p tsconfig.build.json",
    "test": "pnpm build:core && node --test .pulse-build/tests/*.test.js",
    "dataset:preflight": "pnpm build:core && node .pulse-build/src/data/preflight.js",
    "dataset:sample": "pnpm build:core && node .pulse-build/src/data/cli.js",
    "pulse:demo:dry": "pnpm build:core && node .pulse-build/src/demo/dry-run.js"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
