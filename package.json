{
  "name": "pulse-attention-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build:core": "tsc -p tsconfig.build.json",
    "test": "pnpm build:core && node --test .pulse-build/tests/*.test.js",
    "dataset:preflight": "pnpm build:core && node .pulse-build/src/data/preflight.js",
    "dataset:sample": "pnpm build:core && node .pulse-build/src/data/cli.js",
    "pulse:demo:dry": "pnpm build:core && node .pulse-build/src/demo/dry-run.js",
    "contract:prepare": "pnpm build:core && node .pulse-build/scripts/prepare-deployment.js",
    "deploy:preflight": "pnpm build:core && node --env-file=.env .pulse-build/scripts/deployment-preflight.js",
    "deploy:monad-testnet": "pnpm build:core && node --env-file=.env .pulse-build/scripts/deploy-monad-testnet.js"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "viem": "^2.57.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/tx": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3",
    "@types/node": "^22.13.10",
    "solc": "^0.8.37",
    "typescript": "^5.8.2"
  }
}
